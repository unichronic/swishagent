DB_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@localhost:5432/swishagent
REDIS_ADDR=localhost:6379
AGENT_SERVICE_URL=http://localhost:8001
PORT=8080

# LLM providers
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Local JSON tracing
TRACE_ENABLED=1

# Optional Langfuse tracing
LANGFUSE_ENABLED=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
